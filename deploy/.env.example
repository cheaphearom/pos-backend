# ─── Production settings. Copy to deploy/.env and fill in. Never commit deploy/.env ───

# This API's address on Cloudflare (the tunnel's public hostname → http://api:3000)
PUBLIC_URL=https://api.example.com
# The web app's address(es), comma separated (pos-frontend on Cloudflare Workers / your domain)
CORS_ORIGINS=https://pos.example.com,https://pos-system.example.workers.dev

# Turn on the Cloudflare Tunnel (leave as is) and paste the tunnel token from the Cloudflare dashboard.
# Add ,r2 to also copy backups to Cloudflare R2:  COMPOSE_PROFILES=tunnel,r2
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Database (choose a long random password: openssl rand -hex 24)
POSTGRES_USER=pos
POSTGRES_PASSWORD=
POSTGRES_DB=pos

# Login tokens: long random strings (openssl rand -hex 32). Changing them logs everyone out.
JWT_ACCESS_SECRET=
MEMBER_JWT_SECRET=

# First admin, created on the first start only (empty database). Remove the password afterwards.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Business
TZ=Asia/Phnom_Penh
REPORT_TIMEZONE=Asia/Phnom_Penh
LOYALTY_EARN_RATE=1
LOYALTY_POINT_VALUE=0.01
ALLOW_NEGATIVE_STOCK=false
WALLET_CARD_PREFIX=8899

# KHQR: manual (cashier confirms) or bakong (automatic, needs BAKONG_TOKEN)
KHQR_MODE=manual
BAKONG_TOKEN=

# Member app login codes are sent by SMS through your gateway (dev mode is refused in production)
MEMBER_OTP_MODE=webhook
MEMBER_OTP_WEBHOOK_URL=
MEMBER_OTP_WEBHOOK_SECRET=
MEMBER_APP_NAME=Our Café

# Requests per minute per login / per address
RATE_LIMIT_PER_MINUTE=300
# Proxies in front of the API: Cloudflare Tunnel (+1 when the web app's Worker forwards /api)
TRUST_PROXY=2

# Backups: every day at BACKUP_TIME (TZ above), kept BACKUP_KEEP_DAYS days in deploy/backups
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
# Optional copy to Cloudflare R2 (R2 → Manage API tokens → Object Read & Write); add r2 to COMPOSE_PROFILES
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Logs to Loki and the ML anomaly detector (github.com/cheaphearom/ml-detector) ───
# Start the ml-detector stack first, then turn this on (ships deploy/logs to Loki with Grafana Alloy and
# connects the API to the detector):
# COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml
# The same key as DETECTOR_API_KEY in the ml-detector stack's .env (openssl rand -hex 24)
DETECTOR_API_KEY=
# Loki on another server (default: http://loki:3100/loki/api/v1/push on this server)
LOKI_PUSH_URL=
# Logs (in deploy/logs): rotated daily or at LOG_MAX_MB; LOG_MAX_FILES rolled files kept
LOG_MAX_MB=100
LOG_MAX_FILES=14
DB_SLOW_QUERY_MS=500
