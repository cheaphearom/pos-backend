// Multi-store POS database schema.
// Money uses Decimal(14,2); quantities use Decimal(14,3) so items sold by weight work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  SUPER_ADMIN // all stores, all settings
  STORE_MANAGER // manages assigned stores
  CASHIER // sells in assigned stores
}

enum StockMovementType {
  PURCHASE // goods received from supplier
  SALE
  REFUND // goods returned by customer
  ADJUSTMENT // manual count correction, damage, loss
  TRANSFER_OUT
  TRANSFER_IN
  RECIPE // ingredients used up by drinks / dishes sold
  PRODUCTION // finished pieces made here (bakery batch)
  PRODUCTION_USE // ingredients used to make a batch
  WASTE // written off: expired, unsold, damaged
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  KHQR
  BANK_TRANSFER
  E_WALLET // other e-wallets (Wing, TrueMoney...)
  WALLET // the store's own wallet card (stored balance)
  VOUCHER // gift voucher code
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum LoyaltyTxType {
  EARN
  REDEEM
  REVERSE // points taken back on refund
  RETURN // redeemed points given back on refund
  ADJUST // manual change by staff
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// ──────────────────────── Stores & Users ────────────────────────

model Store {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(20) // short code used in receipt numbers, e.g. "PP01"
  name       String   @db.VarChar(150)
  address    String?
  phone      String?  @db.VarChar(30)
  currency   String   @default("USD") @db.VarChar(3)
  taxRate    Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4) // 0.1000 = 10%
  receiptSeq Int      @default(0) @map("receipt_seq") // last used receipt number
  isActive   Boolean  @default(true) @map("is_active")
  /// This store's id in the BROWN system (idoutlet), used to sync its menu
  externalId String?  @unique @map("external_id") @db.VarChar(50)

  // KHQR (Bakong) settings. Without an account id, KHQR codes cannot be generated for this store.
  khqrAccountId    String? @map("khqr_account_id") @db.VarChar(32) // e.g. myshop@aclb
  khqrMerchantName String? @map("khqr_merchant_name") @db.VarChar(25)
  khqrCity         String? @map("khqr_city") @db.VarChar(15)
  khqrMerchantId   String? @map("khqr_merchant_id") @db.VarChar(32) // set for merchant accounts (tag 30)
  khqrBank         String? @map("khqr_bank") @db.VarChar(32) // acquiring bank name

  /// Café mode: orders get a queue number and go to the barista / kitchen screen
  hasKitchen Boolean @default(false) @map("has_kitchen")
  /// Customers can order on their phone (pickup, or by scanning a table QR code)
  onlineOrdering Boolean @default(false) @map("online_ordering")

  /// Cashier controls: biggest manual discount a cashier may give without a manager PIN (% of the sale)
  cashierMaxDiscountPercent Decimal @default(10) @map("cashier_max_discount_percent") @db.Decimal(5, 2)
  /// Cashiers need a manager PIN to refund / to void a sale
  refundNeedsApproval Boolean @default(true) @map("refund_needs_approval")
  voidNeedsApproval   Boolean @default(true) @map("void_needs_approval")

  /// Dual currency: riel per 1 USD (e.g. 4100). Empty = riel cash is off for this store.
  khrRate Int? @map("khr_rate")
  /// Cashiers need a manager PIN to take money out of the drawer (pay-out)
  cashOutNeedsApproval Boolean @default(true) @map("cash_out_needs_approval")
  /// Last Z report number of this store
  zSeq    Int  @default(0) @map("z_seq")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  users          StoreUser[]
  inventory      Inventory[]
  stockMovements StockMovement[]
  sales          Sale[]
  shifts         Shift[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")
  apiKeys        ApiKey[]
  purchaseOrders PurchaseOrder[]
  khqrPayments   KhqrPayment[]
  productionBatches ProductionBatch[]
  wasteEntries      WasteEntry[]

  @@map("stores")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(150)
  phone        String?  @db.VarChar(30)
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  /// Managers: PIN typed on a cashier's POS to approve a big discount, refund or void
  approvalPinHash String? @map("approval_pin_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stores        StoreUser[]
  refreshTokens RefreshToken[]
  sales         Sale[]
  shifts        Shift[]
  refunds       Refund[]

  @@map("users")
}

/// Which stores a manager / cashier can work in. Super admins see all stores.
model StoreUser {
  storeId   String   @map("store_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────── Catalogue & Stock ───────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  /// Khmer name
  nameKm    String?    @map("name_km") @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, name])
  @@map("categories")
}

/// One shared catalogue for all stores. Which stores sell a product, and their own price and stock, live in Inventory.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(50)
  barcode     String?  @unique @db.VarChar(64)
  name        String   @db.VarChar(200)
  /// Khmer name, shown when the screen is in Khmer
  nameKm      String?  @map("name_km") @db.VarChar(200)
  description String?
  categoryId  String?  @map("category_id") @db.Uuid
  unit        String   @default("pcs") @db.VarChar(20)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(14, 6) // per unit; ingredients can cost $0.0016 per ml
  sellPrice   Decimal  @map("sell_price") @db.Decimal(14, 2)
  taxable     Boolean  @default(true)
  trackStock  Boolean  @default(true) @map("track_stock") // false for services
  isActive    Boolean  @default(true) @map("is_active")
  imageUrl    String?  @map("image_url")
  /// Ingredient / supply (beans, milk, cups): kept in stock, used by recipes, not sold at the POS
  isIngredient Boolean @default(false) @map("is_ingredient")
  /// Shown on the online ordering menu
  onlineAvailable Boolean @default(false) @map("online_available")
  /// Bakery / kitchen item made here in batches. Its recipe is for ONE batch and is used when the batch is made,
  /// not when it is sold (sales take finished pieces from stock).
  madeInHouse    Boolean  @default(false) @map("made_in_house")
  /// Pieces one recipe batch makes (e.g. 24 croissants)
  batchYield     Decimal  @default(1) @map("batch_yield") @db.Decimal(10, 3)
  /// Fresh for this many hours after baking (unsold pieces after that are written off)
  shelfLifeHours Int?     @map("shelf_life_hours")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modifierGroups ProductModifierGroup[]
  recipe         RecipeItem[]         @relation("RecipeOf")
  usedIn         RecipeItem[]         @relation("RecipeIngredient")
  inventory      Inventory[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  transferItems  StockTransferItem[]
  poItems        PurchaseOrderItem[]
  productionBatches ProductionBatch[]
  wasteEntries      WasteEntry[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

/// One product in one store: whether the store sells it, its stock level and optional own price.
/// A store sells only the products that have a row here with isListed = true.
model Inventory {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel  Decimal  @default(0) @map("reorder_level") @db.Decimal(14, 3)
  priceOverride Decimal? @map("price_override") @db.Decimal(14, 2)
  /// This store sells this product (shown on its POS, menu and product list). Turning it off keeps the stock.
  isListed      Boolean  @default(true) @map("is_listed")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@index([storeId, isListed])
  @@map("inventory")
}

/// Every stock change ever made (append-only ledger). Grows large -> BigInt id.
model StockMovement {
  id            BigInt            @id @default(autoincrement())
  storeId       String            @map("store_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3) // + in, - out
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(14, 3)
  referenceType String?           @map("reference_type") @db.VarChar(30) // SALE, REFUND, TRANSFER...
  referenceId   String?           @map("reference_id") @db.VarChar(64)
  note          String?
  userId        String?           @map("user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, createdAt])
  @@index([storeId, createdAt])
  @@map("stock_movements")
}

model StockTransfer {
  id          String         @id @default(uuid()) @db.Uuid
  transferNo  String         @unique @map("transfer_no") @db.VarChar(40)
  fromStoreId String         @map("from_store_id") @db.Uuid
  toStoreId   String         @map("to_store_id") @db.Uuid
  status      TransferStatus @default(IN_TRANSIT)
  note        String?
  createdById String?        @map("created_by_id") @db.Uuid
  receivedById String?       @map("received_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  receivedAt  DateTime?      @map("received_at")

  fromStore Store               @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore   Store               @relation("TransferTo", fields: [toStoreId], references: [id])
  items     StockTransferItem[]

  @@index([fromStoreId, createdAt])
  @@index([toStoreId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String  @id @default(uuid()) @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

// ─────────────────────── Customers & Loyalty ───────────────────────

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30) // member card number
  name        String   @db.VarChar(150)
  phone       String?  @unique @db.VarChar(30)
  email       String?  @db.VarChar(150)
  points      Int      @default(0)
  totalSpent  Decimal  @default(0) @map("total_spent") @db.Decimal(14, 2)
  visitCount  Int      @default(0) @map("visit_count")
  isActive    Boolean  @default(true) @map("is_active")
  /// First login in the member app
  appJoinedAt     DateTime? @map("app_joined_at")
  appLastSeenAt   DateTime? @map("app_last_seen_at")
  /// Raising this logs the member out of the app on every phone
  appTokenVersion Int       @default(0) @map("app_token_version")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sales        Sale[]
  onlineOrders OnlineOrder[]
  loyaltyTxns  LoyaltyTransaction[]
  walletCards  WalletCard[]

  @@index([name])
  @@map("customers")
}

model LoyaltyTransaction {
  id           BigInt        @id @default(autoincrement())
  customerId   String        @map("customer_id") @db.Uuid
  type         LoyaltyTxType
  points       Int // + or -
  balanceAfter Int           @map("balance_after")
  saleId       String?       @map("sale_id") @db.Uuid
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("loyalty_transactions")
}

// ─────────────────────────── Sales ───────────────────────────

model Shift {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @map("opening_cash") @db.Decimal(14, 2)
  closingCash  Decimal?    @map("closing_cash") @db.Decimal(14, 2) // counted by cashier
  expectedCash Decimal?    @map("expected_cash") @db.Decimal(14, 2) // calculated by system
  /// Riel drawer (dual currency stores)
  openingKhr   Int         @default(0) @map("opening_khr")
  closingKhr   Int?        @map("closing_khr")
  expectedKhr  Int?        @map("expected_khr")
  note         String?
  openedAt     DateTime    @default(now()) @map("opened_at")
  closedAt     DateTime?   @map("closed_at")

  store Store  @relation(fields: [storeId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]
  cashMovements CashMovement[]

  @@index([storeId, openedAt])
  @@index([userId, status])
  @@map("shifts")
}

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  receiptNo      String     @unique @map("receipt_no") @db.VarChar(40)
  clientRef      String?    @unique @map("client_ref") @db.VarChar(64) // idempotency key (offline sync / integrations)
  storeId        String     @map("store_id") @db.Uuid
  shiftId        String?    @map("shift_id") @db.Uuid
  cashierId      String?    @map("cashier_id") @db.Uuid // null when created by an integration
  customerId     String?    @map("customer_id") @db.Uuid
  channel        String     @default("POS") @db.VarChar(20) // POS, ONLINE, API...
  orderType      OrderType  @default(RETAIL) @map("order_type")
  tableNo        String?    @map("table_no") @db.VarChar(20)
  queueNo        String?    @map("queue_no") @db.VarChar(10) // A001.. per store per day (café mode)
  kitchenStatus  KitchenStatus @default(NONE) @map("kitchen_status")
  kitchenStartedAt DateTime? @map("kitchen_started_at")
  readyAt        DateTime?  @map("ready_at")
  completedAt    DateTime?  @map("completed_at")
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(14, 2) // before discounts & tax
  discountTotal  Decimal    @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal       Decimal    @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal    @db.Decimal(14, 2) // subtotal - discount + tax
  pointsRedeemed Int        @default(0) @map("points_redeemed")
  pointsDiscount Decimal    @default(0) @map("points_discount") @db.Decimal(14, 2)
  amountDue      Decimal    @map("amount_due") @db.Decimal(14, 2) // total - pointsDiscount
  amountPaid     Decimal    @map("amount_paid") @db.Decimal(14, 2)
  changeDue      Decimal    @default(0) @map("change_due") @db.Decimal(14, 2)
  /// How the change was given: dollars + riel (riel rounded to 100)
  changeUsd      Decimal    @default(0) @map("change_usd") @db.Decimal(14, 2)
  changeKhr      Int        @default(0) @map("change_khr")
  pointsEarned   Int        @default(0) @map("points_earned")
  couponCodeId   String?    @map("coupon_code_id") @db.Uuid
  couponDiscount Decimal    @default(0) @map("coupon_discount") @db.Decimal(14, 2)
  couponName     String?    @map("coupon_name") @db.VarChar(100) // snapshot for the receipt
  refundedTotal  Decimal    @default(0) @map("refunded_total") @db.Decimal(14, 2)
  note           String?
  createdAt      DateTime   @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id])
  shift    Shift?    @relation(fields: [shiftId], references: [id])
  cashier  User?     @relation(fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments Payment[]
  refunds  Refund[]

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@index([shiftId])
  @@index([createdAt])
  @@index([storeId, kitchenStatus])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @map("sale_id") @db.Uuid
  lineNo       Int     @map("line_no") // order on the receipt
  productId    String  @map("product_id") @db.Uuid
  sku          String  @db.VarChar(50) // snapshot at time of sale
  name         String  @db.VarChar(200)
  nameKm       String? @map("name_km") @db.VarChar(200) // Khmer name at the time of sale (receipts)
  quantity     Decimal @db.Decimal(14, 3)
  unitPrice    Decimal @map("unit_price") @db.Decimal(14, 2)
  costPrice    Decimal @map("cost_price") @db.Decimal(14, 6) // per unit at the time of sale (recipe cost for drinks)
  discount     Decimal @default(0) @db.Decimal(14, 2) // line + share of sale discount
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 4)
  netAmount    Decimal @map("net_amount") @db.Decimal(14, 2) // qty*price - discount
  taxAmount    Decimal @map("tax_amount") @db.Decimal(14, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2) // net + tax
  refundedQty  Decimal @default(0) @map("refunded_qty") @db.Decimal(14, 3)
  modifiers     Json?    // snapshot: [{ group, option, price }]
  note          String?  @db.VarChar(200) // e.g. "less sweet", "hot please"
  promotionId   String?  @map("promotion_id") @db.Uuid
  promoDiscount Decimal  @default(0) @map("promo_discount") @db.Decimal(14, 2) // part of `discount` that came from the promotion

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion   Promotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  product     Product      @relation(fields: [productId], references: [id])
  refundItems RefundItem[]

  @@index([saleId])
  @@index([productId])
  @@index([promotionId])
  @@map("sale_items")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @map("sale_id") @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  reference String?       @db.VarChar(100) // card approval code, KHQR transaction id...
  /// Cash in riel: amount is the USD value; tendered is the riel handed over, at rate riel per USD
  currency  String        @default("USD") @db.VarChar(3)
  tendered  Decimal?      @db.Decimal(16, 2)
  rate      Decimal?      @db.Decimal(12, 4)
  createdAt DateTime      @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

model Refund {
  id             String        @id @default(uuid()) @db.Uuid
  refundNo       String        @unique @map("refund_no") @db.VarChar(40)
  saleId         String        @map("sale_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  method         PaymentMethod @default(CASH)
  amount         Decimal       @db.Decimal(14, 2) // money given back
  pointsReturned Int           @default(0) @map("points_returned")
  pointsReversed Int           @default(0) @map("points_reversed")
  restock        Boolean       @default(true)
  reason         String?
  createdAt      DateTime      @default(now()) @map("created_at")

  sale  Sale         @relation(fields: [saleId], references: [id])
  user  User?        @relation(fields: [userId], references: [id])
  items RefundItem[]

  @@index([saleId])
  @@index([createdAt])
  @@map("refunds")
}

model RefundItem {
  id         String  @id @default(uuid()) @db.Uuid
  refundId   String  @map("refund_id") @db.Uuid
  saleItemId String  @map("sale_item_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)
  amount     Decimal @db.Decimal(14, 2)

  refund   Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@map("refund_items")
}

// ──────────────────────── Integrations ────────────────────────

/// Key for other systems (accounting, e-commerce, ERP). Only the SHA-256 hash is stored.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  prefix      String    @db.VarChar(16) // first chars, shown in UI to identify the key
  keyHash     String    @unique @map("key_hash")
  scopes      String[]  @default([])
  storeId     String?   @map("store_id") @db.Uuid // null = all stores
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

/// Other systems register a URL to be told about events (sale.created, stock.low ...).
model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  secret    String // used to sign payloads (HMAC-SHA256)
  events    String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           BigInt                @id @default(autoincrement())
  endpointId   String                @map("endpoint_id") @db.Uuid
  event        String                @db.VarChar(50)
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  lastError    String?               @map("last_error")
  createdAt    DateTime              @default(now()) @map("created_at")
  deliveredAt  DateTime?             @map("delivered_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ──────────────────────── Purchasing ────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique @db.VarChar(30)
  name             String   @db.VarChar(150)
  contactName      String?  @map("contact_name") @db.VarChar(150)
  phone            String?  @db.VarChar(30)
  email            String?  @db.VarChar(150)
  address          String?
  taxId            String?  @map("tax_id") @db.VarChar(50)
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  note             String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  poNo        String              @unique @map("po_no") @db.VarChar(40)
  supplierId  String              @map("supplier_id") @db.Uuid
  storeId     String              @map("store_id") @db.Uuid // delivery store
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?           @map("expected_at")
  note        String?
  subtotal    Decimal             @default(0) @db.Decimal(14, 2)
  createdById String?             @map("created_by_id") @db.Uuid
  orderedAt   DateTime?           @map("ordered_at")
  receivedAt  DateTime?           @map("received_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  store    Store               @relation(fields: [storeId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([storeId, createdAt])
  @@index([supplierId, createdAt])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  lineNo          Int     @map("line_no")
  productId       String  @map("product_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(14, 6)
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

/// One delivery against a purchase order (a PO can arrive in several deliveries).
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  reference       String?  @db.VarChar(100) // supplier invoice / delivery note number
  note            String?
  userId          String?  @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  unitCost            Decimal @map("unit_cost") @db.Decimal(14, 6)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("goods_receipt_items")
}

// ──────────────────────── Promotions ────────────────────────

enum PromotionType {
  PERCENT_OFF // value = percent, e.g. 10
  AMOUNT_OFF // value = amount off each unit
  BUY_X_GET_Y // buy `buyQty`, get `getQty` free (same product)
}

model Promotion {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(100) // shown on receipts
  description String?
  type        PromotionType
  value       Decimal       @default(0) @db.Decimal(14, 4)
  buyQty      Int?          @map("buy_qty")
  getQty      Int?          @map("get_qty")
  allProducts Boolean       @default(false) @map("all_products")
  productIds  String[]      @default([]) @map("product_ids")
  categoryIds String[]      @default([]) @map("category_ids")
  storeIds    String[]      @default([]) @map("store_ids") // empty = all stores
  startsAt    DateTime?     @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  daysOfWeek  Int[]         @default([]) @map("days_of_week") // 0 = Sunday ... 6 = Saturday; empty = every day
  startMinute Int?          @map("start_minute") // happy hour start, minutes after midnight (store time)
  endMinute   Int?          @map("end_minute")
  priority    Int           @default(0)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  saleItems SaleItem[]

  @@index([isActive])
  @@map("promotions")
}

// ──────────────────────── KHQR payments ────────────────────────

enum KhqrStatus {
  PENDING
  PAID
  EXPIRED
}

/// A dynamic KHQR code generated for one payment. md5 is what Bakong uses to look the payment up.
model KhqrPayment {
  id              String     @id @default(uuid()) @db.Uuid
  md5             String     @unique @db.VarChar(32)
  storeId         String     @map("store_id") @db.Uuid
  amount          Decimal    @db.Decimal(14, 2)
  currency        String     @db.VarChar(3)
  billNumber      String     @map("bill_number") @db.VarChar(25)
  qr              String
  status          KhqrStatus @default(PENDING)
  expiresAt       DateTime   @map("expires_at")
  paidAt          DateTime?  @map("paid_at")
  transactionHash String?    @map("transaction_hash") @db.VarChar(100)
  fromAccount     String?    @map("from_account") @db.VarChar(100)
  confirmedById   String?    @map("confirmed_by_id") @db.Uuid // set when confirmed by hand
  lastCheckedAt   DateTime?  @map("last_checked_at")
  saleId          String?    @unique @map("sale_id") @db.Uuid // a payment can pay for one sale only
  createdById     String?    @map("created_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@map("khqr_payments")
}

// ──────────────────────── Wallet cards (stored value) ────────────────────────

enum WalletCardStatus {
  INACTIVE // printed, not given to a customer yet
  ACTIVE
  BLOCKED // lost / suspicious: cannot pay or top up
  CLOSED // replaced or cancelled; balance moved away
}

enum WalletTxType {
  TOPUP
  PAYMENT
  REFUND
  ADJUST
  TRANSFER_IN
  TRANSFER_OUT
}

/// A customer's wallet card. The card number is the barcode; the serial (printed on the back) proves you hold the card.
model WalletCard {
  id           String           @id @default(uuid()) @db.Uuid
  cardNumber   String           @unique @map("card_number") @db.VarChar(19)
  serialNumber String           @unique @map("serial_number") @db.VarChar(20)
  customerId   String?          @map("customer_id") @db.Uuid
  status       WalletCardStatus @default(INACTIVE)
  balance      Decimal          @default(0) @db.Decimal(14, 2)
  pinHash      String?          @map("pin_hash")
  pinFailures  Int              @default(0) @map("pin_failures")
  note         String?
  issuedAt     DateTime         @default(now()) @map("issued_at")
  activatedAt  DateTime?        @map("activated_at")
  lastUsedAt   DateTime?        @map("last_used_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  customer     Customer?           @relation(fields: [customerId], references: [id])
  transactions WalletTransaction[]

  @@index([customerId])
  @@index([status])
  @@map("wallet_cards")
}

/// Every balance change (append-only ledger).
model WalletTransaction {
  id           BigInt         @id @default(autoincrement())
  cardId       String         @map("card_id") @db.Uuid
  type         WalletTxType
  amount       Decimal        @db.Decimal(14, 2) // + in, - out
  balanceAfter Decimal        @map("balance_after") @db.Decimal(14, 2)
  method       PaymentMethod? // how a top-up was paid
  reference    String?        @db.VarChar(100)
  clientRef    String?        @unique @map("client_ref") @db.VarChar(64) // stops a retried top-up counting twice
  saleId       String?        @map("sale_id") @db.Uuid
  storeId      String?        @map("store_id") @db.Uuid
  shiftId      String?        @map("shift_id") @db.Uuid
  userId       String?        @map("user_id") @db.Uuid
  note         String?
  createdAt    DateTime       @default(now()) @map("created_at")

  card WalletCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([storeId, createdAt])
  @@index([shiftId])
  @@map("wallet_transactions")
}

// ──────────────────────── Coupons (discount codes) ────────────────────────

enum CouponType {
  PERCENT // value = percent off the sale
  AMOUNT // value = amount off the sale
}

model CouponCampaign {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @db.VarChar(100) // shown on the receipt
  type             CouponType
  value            Decimal    @db.Decimal(14, 2)
  minSpend         Decimal    @default(0) @map("min_spend") @db.Decimal(14, 2)
  maxDiscount      Decimal?   @map("max_discount") @db.Decimal(14, 2) // cap for percent coupons
  storeIds         String[]   @default([]) @map("store_ids") // empty = all stores
  startsAt         DateTime?  @map("starts_at")
  endsAt           DateTime?  @map("ends_at")
  usageLimit       Int?       @map("usage_limit") // total uses of the whole campaign
  perCustomerLimit Int?       @map("per_customer_limit")
  membersOnly      Boolean    @default(false) @map("members_only")
  isActive         Boolean    @default(true) @map("is_active")
  usedCount        Int        @default(0) @map("used_count")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  codes       CouponCode[]
  redemptions CouponRedemption[]

  @@map("coupon_campaigns")
}

/// One code of a campaign: a shared code (many uses) or a unique single-use code.
model CouponCode {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  code       String   @unique @db.VarChar(40)
  maxUses    Int?     @map("max_uses") // null = unlimited (shared code); 1 = single use
  usedCount  Int      @default(0) @map("used_count")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign    CouponCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@index([campaignId])
  @@map("coupon_codes")
}

model CouponRedemption {
  id         BigInt   @id @default(autoincrement())
  codeId     String   @map("code_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  saleId     String   @unique @map("sale_id") @db.Uuid // one coupon per sale
  customerId String?  @map("customer_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  discount   Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  code     CouponCode     @relation(fields: [codeId], references: [id], onDelete: Cascade)
  campaign CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([customerId, campaignId])
  @@map("coupon_redemptions")
}

// ──────────────────────── Gift vouchers (prepaid codes) ────────────────────────

enum VoucherStatus {
  INACTIVE // printed, not sold yet (sold vouchers only)
  ACTIVE
  USED // value fully spent
  VOID // cancelled
}

model VoucherBatch {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  value     Decimal   @db.Decimal(14, 2)
  /// true = customers buy them (money in; activated when sold). false = given free (promotion), active at once.
  sold      Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  count     Int
  createdAt DateTime  @default(now()) @map("created_at")

  vouchers Voucher[]

  @@map("voucher_batches")
}

model Voucher {
  id         String        @id @default(uuid()) @db.Uuid
  batchId    String        @map("batch_id") @db.Uuid
  code       String        @unique @db.VarChar(40)
  value      Decimal       @db.Decimal(14, 2)
  balance    Decimal       @db.Decimal(14, 2) // what is left to spend
  status     VoucherStatus @default(INACTIVE)
  expiresAt  DateTime?     @map("expires_at")
  soldAt     DateTime?     @map("sold_at")
  soldStoreId String?      @map("sold_store_id") @db.Uuid
  soldMethod PaymentMethod? @map("sold_method")
  soldShiftId String?      @map("sold_shift_id") @db.Uuid
  soldById   String?       @map("sold_by_id") @db.Uuid
  note       String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  batch VoucherBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  uses  VoucherUse[]

  @@index([batchId])
  @@index([status])
  @@map("vouchers")
}

model VoucherUse {
  id        BigInt   @id @default(autoincrement())
  voucherId String   @map("voucher_id") @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2) // + spent, - given back on refund
  createdAt DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([saleId])
  @@map("voucher_uses")
}

// ──────────────────────── Café: drink options & kitchen ────────────────────────

enum OrderType {
  RETAIL // normal shop sale
  TAKEAWAY
  DINE_IN
  PICKUP // ordered ahead online
  DELIVERY
}

enum KitchenStatus {
  NONE // not a kitchen order
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

/// A set of choices for drinks/food, e.g. "Size" (S/M/L) or "Sugar level".
model ModifierGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(60)
  minSelect Int      @default(0) @map("min_select") // 1 = required
  maxSelect Int      @default(1) @map("max_select") // 1 = choose one
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  name       String   @db.VarChar(60)
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(14, 2) // added to the item price
  isDefault  Boolean  @default(false) @map("is_default")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")

  group   ModifierGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  effects ModifierEffect[]

  @@index([groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  productId String @map("product_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
  @@map("product_modifier_groups")
}

/// Daily queue numbers per store (A001, A002, ...).
model StoreDayCounter {
  storeId String   @map("store_id") @db.Uuid
  day     DateTime @db.Date
  seq     Int      @default(0)

  @@id([storeId, day])
  @@map("store_day_counters")
}

// ──────────────────────── Recipes (ingredient stock) ────────────────────────

/// One ingredient of a product's base recipe, e.g. Latte uses 18 g coffee beans.
model RecipeItem {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 4) // in the ingredient's unit (g, ml, pcs)

  product    Product @relation("RecipeOf", fields: [productId], references: [id], onDelete: Cascade)
  ingredient Product @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

enum RecipeEffectType {
  SCALE // percent change: all ingredients except pieces (cups, lids), or only `ingredientId`
  REPLACE // use `replaceWithId` instead of `ingredientId` (oat milk instead of fresh milk)
  ADD // add `quantity` of `ingredientId` (extra shot, whipped cream)
}

/// How a drink option changes the recipe. Applies to every product that offers the option.
model ModifierEffect {
  id            String           @id @default(uuid()) @db.Uuid
  optionId      String           @map("option_id") @db.Uuid
  type          RecipeEffectType
  ingredientId  String?          @map("ingredient_id") @db.Uuid
  replaceWithId String?          @map("replace_with_id") @db.Uuid
  quantity      Decimal?         @db.Decimal(14, 4)
  percent       Decimal?         @db.Decimal(7, 2) // +30 = 30% more, -50 = half

  option ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("modifier_effects")
}

// ──────────────────────── Online orders (order ahead / table QR) ────────────────────────

enum OnlineOrderStatus {
  PENDING_PAYMENT // waiting for the KHQR payment
  PAY_AT_COUNTER // customer pays the cashier
  PAID // became a sale and went to the barista
  CANCELLED
  EXPIRED // not paid in time
  FAILED // payment received but the sale could not be created (needs a manager)
}

model OnlineOrder {
  id           String            @id @default(uuid()) @db.Uuid
  token        String            @unique @db.VarChar(48) // secret link for the customer's status page
  storeId      String            @map("store_id") @db.Uuid
  status       OnlineOrderStatus
  orderType    OrderType         @map("order_type")
  tableNo      String?           @map("table_no") @db.VarChar(20)
  customerName String            @map("customer_name") @db.VarChar(80)
  phone        String?           @db.VarChar(30)
  note         String?           @db.VarChar(200)
  items        Json // what the customer ordered (product, quantity, options, note)
  couponCode   String?           @map("coupon_code") @db.VarChar(40)
  total        Decimal           @db.Decimal(14, 2) // quoted when ordered
  khqrMd5      String?           @map("khqr_md5") @db.VarChar(32)
  /// Placed from the member app while logged in
  customerId   String?           @map("customer_id") @db.Uuid
  /// Member app: paid from this wallet card
  walletCardId String?           @map("wallet_card_id") @db.Uuid
  redeemPoints Int               @default(0) @map("redeem_points")
  saleId       String?           @unique @map("sale_id") @db.Uuid
  error        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  paidAt       DateTime?         @map("paid_at")

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([storeId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("online_orders")
}

/// One-time login codes for the member app (sent by SMS / Telegram)
model MemberOtp {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String    @db.VarChar(30)
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("member_otps")
}

// ─────────────────────────── Bakery production ───────────────────────────

enum ProductionStatus {
  PLANNED
  DONE
  CANCELLED
}

/// One batch made in a store: ingredients out, finished pieces in, cost per piece.
model ProductionBatch {
  id            String           @id @default(uuid()) @db.Uuid
  batchNo       String           @unique @map("batch_no") @db.VarChar(40)
  storeId       String           @map("store_id") @db.Uuid
  productId     String           @map("product_id") @db.Uuid
  status        ProductionStatus @default(PLANNED)
  plannedQty    Decimal          @map("planned_qty") @db.Decimal(14, 3)
  producedQty   Decimal?         @map("produced_qty") @db.Decimal(14, 3)
  unitCost      Decimal?         @map("unit_cost") @db.Decimal(14, 6)
  totalCost     Decimal?         @map("total_cost") @db.Decimal(14, 2)
  /// What was used, for the batch sheet: [{ ingredientId, name, unit, quantity, cost }]
  ingredients   Json?
  expiresAt     DateTime?        @map("expires_at")
  note          String?          @db.VarChar(200)
  createdById   String?          @map("created_by_id") @db.Uuid
  completedById String?          @map("completed_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  completedAt   DateTime?        @map("completed_at")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId, createdAt])
  @@index([storeId, productId, completedAt])
  @@map("production_batches")
}

enum WasteReason {
  EXPIRED
  UNSOLD
  DAMAGED
  QUALITY
  OTHER
}

/// Stock written off, with its cost at the time (for the waste report).
model WasteEntry {
  id        String      @id @default(uuid()) @db.Uuid
  storeId   String      @map("store_id") @db.Uuid
  productId String      @map("product_id") @db.Uuid
  quantity  Decimal     @db.Decimal(14, 3)
  unitCost  Decimal     @map("unit_cost") @db.Decimal(14, 6)
  reason    WasteReason
  note      String?     @db.VarChar(200)
  userId    String?     @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId, createdAt])
  @@map("waste_entries")
}

// ─────────────────────────── Cashier controls ───────────────────────────

enum ApprovalAction {
  DISCOUNT
  REFUND
  VOID
  CASH_OUT
}

/// A manager typed their PIN on a cashier's POS. Used once, within a few minutes, for one action.
model Approval {
  id            String         @id @default(uuid()) @db.Uuid
  storeId       String         @map("store_id") @db.Uuid
  action        ApprovalAction
  /// DISCOUNT: highest discount % allowed by this approval
  maxPercent    Decimal?       @map("max_percent") @db.Decimal(5, 2)
  /// CASH_OUT: most money (USD value) allowed out of the drawer
  maxAmount     Decimal?       @map("max_amount") @db.Decimal(14, 2)
  /// REFUND / VOID: the sale it is for
  saleId        String?        @map("sale_id") @db.Uuid
  managerId     String         @map("manager_id") @db.Uuid
  requestedById String         @map("requested_by_id") @db.Uuid
  reason        String?        @db.VarChar(200)
  expiresAt     DateTime       @map("expires_at")
  usedAt        DateTime?      @map("used_at")
  usedFor       String?        @map("used_for") @db.VarChar(64)
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@map("approvals")
}

/// Who did what: discounts over the limit, refunds, voids, PIN approvals and failures,
/// price and stock changes, points and wallet adjustments, user and store changes, logins.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at")
  storeId        String?  @map("store_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  userName       String?  @map("user_name") @db.VarChar(150)
  action         String   @db.VarChar(50)
  entityType     String?  @map("entity_type") @db.VarChar(30)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  summary        String   @db.VarChar(300)
  details        Json?
  approvedById   String?  @map("approved_by_id") @db.Uuid
  approvedByName String?  @map("approved_by_name") @db.VarChar(150)
  ip             String?  @db.VarChar(64)

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── Drawer: cash in / out, X and Z reports ───────────────────────────

enum CashMoveType {
  PAY_IN // money put into the drawer (float, change from the bank)
  PAY_OUT // money taken out (supplier paid in cash, bank drop, petty cash)
}

model CashMovement {
  id           String       @id @default(uuid()) @db.Uuid
  shiftId      String       @map("shift_id") @db.Uuid
  storeId      String       @map("store_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  type         CashMoveType
  /// USD or KHR (riel are whole numbers)
  currency     String       @default("USD") @db.VarChar(3)
  amount       Decimal      @db.Decimal(14, 2)
  reason       String       @db.VarChar(200)
  approvedById String?      @map("approved_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@index([storeId, createdAt])
  @@map("cash_movements")
}

/// End of day for a store. The figures are saved when it is run and never change; reprints show the same numbers.
model ZReport {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  zNo         Int      @map("z_no")
  businessDay DateTime @map("business_day") @db.Date
  fromAt      DateTime @map("from_at")
  toAt        DateTime @map("to_at")
  data        Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([storeId, businessDay])
  @@unique([storeId, zNo])
  @@map("z_reports")
}
