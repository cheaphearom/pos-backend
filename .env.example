# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Database / cache
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos?schema=public
REDIS_URL=redis://localhost:6379

# Auth (CHANGE THESE IN PRODUCTION - use long random strings)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Loyalty: points earned per 1 unit of currency paid, and value of 1 point when redeemed
LOYALTY_EARN_RATE=1
LOYALTY_POINT_VALUE=0.01

# Inventory: allow selling when stock is 0 (true/false)
ALLOW_NEGATIVE_STOCK=false

# Rate limit: requests per minute per client
RATE_LIMIT_PER_MINUTE=300

# Time zone for "daily" reports
REPORT_TIMEZONE=Asia/Phnom_Penh

# KHQR (Bakong). manual = cashier confirms payment; bakong = automatic check (needs a token
# from https://api-bakong.nbc.gov.kh). Each store's Bakong account is set on the Stores page.
KHQR_MODE=manual
BAKONG_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
KHQR_EXPIRY_MINUTES=5

# Wallet cards: first digits of generated card numbers
WALLET_CARD_PREFIX=8899

# Member app login codes (phone + one-time code).
# dev: the code is shown in the app (testing only; not allowed in production)
# webhook: the code is POSTed as JSON {phone, code, message} to your SMS gateway / bot
MEMBER_OTP_MODE=dev
MEMBER_OTP_WEBHOOK_URL=
MEMBER_OTP_WEBHOOK_SECRET=
MEMBER_APP_NAME=our café
# MEMBER_JWT_SECRET=   (defaults to one derived from JWT_ACCESS_SECRET)
# MEMBER_TOKEN_DAYS=60

# Logs: JSON lines (read by the ML anomaly detector) to stdout and ${LOG_DIR}/pos-api.log.
# The file is rotated daily or at LOG_MAX_MB; LOG_MAX_FILES rolled files (.log.gz) are kept.
LOG_DIR=./logs
LOG_LEVEL=info
LOG_MAX_MB=100
LOG_MAX_FILES=14
# Database queries slower than this are logged as event=db_query_slow
DB_SLOW_QUERY_MS=500
# Shift close: a cash difference above this amount is logged as event=cash_mismatch
CASH_MISMATCH_THRESHOLD=1

# ML anomaly detector (docker compose --profile monitoring up -d --build)
DETECTOR_URL=http://localhost:8000
DETECTOR_API_KEY=
# Telegram alerts (see README): leave empty to turn them off. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_METHODS=
NOTIFY_RESOLVE_AFTER_S=60
NOTIFY_TIMEZONE=Asia/Phnom_Penh

# Fault injection for testing the alerts (scripts/chaos.mjs). Development only: the API refuses to
# start with CHAOS_ENABLED=true when NODE_ENV=production, and deploy/docker-compose.yml forces it off.
CHAOS_ENABLED=false
