# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Database / cache
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos?schema=public
REDIS_URL=redis://localhost:6379

# Auth (CHANGE THESE IN PRODUCTION - use long random strings)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Loyalty: points earned per 1 unit of currency paid, and value of 1 point when redeemed
LOYALTY_EARN_RATE=1
LOYALTY_POINT_VALUE=0.01

# Inventory: allow selling when stock is 0 (true/false)
ALLOW_NEGATIVE_STOCK=false

# Rate limit: requests per minute per client
RATE_LIMIT_PER_MINUTE=300

# Time zone for "daily" reports
REPORT_TIMEZONE=Asia/Phnom_Penh

# KHQR (Bakong). manual = cashier confirms payment; bakong = automatic check (needs a token
# from https://api-bakong.nbc.gov.kh). Each store's Bakong account is set on the Stores page.
KHQR_MODE=manual
BAKONG_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
KHQR_EXPIRY_MINUTES=5

# Wallet cards: first digits of generated card numbers
WALLET_CARD_PREFIX=8899
